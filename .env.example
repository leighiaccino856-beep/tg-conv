# Токен от @BotFather — обязателен.
BOT_TOKEN=

# Адрес локального Bot API server (например, http://localhost:8081).
# Нужен только если хочешь принимать файлы больше 20 МБ. Оставь пустым для облака.
TELEGRAM_API_SERVER=

# Прямой IP для api.telegram.org. Выручает, когда DNS провайдера отдаёт
# заблокированный адрес, а другие адреса Telegram доступны.
# Можно несколько через запятую: 149.154.167.220,149.154.175.50.
# Оставь пустым, если api.telegram.org открывается напрямую.
TELEGRAM_API_IP=

# Прокси для запросов к Telegram: http://, socks5:// (можно с логином).
# Например: socks5://127.0.0.1:1080 или http://user:pass@10.0.0.1:3128.
# Если задан прокси, TELEGRAM_API_IP игнорируется.
TELEGRAM_PROXY=

# Максимальный размер входного файла, МБ. 20 — лимит облачного Bot API,
# для локального сервера можно поднять до 2000.
MAX_INPUT_MB=20

# Целевой размер кружка, МБ. Документированный лимит Telegram — 1 МБ,
# но на практике боты отправляют и больше.
NOTE_MAX_MB=5

# На этот размер бот пережмёт кружок, если Telegram откажется его принять.
FALLBACK_NOTE_MB=1

# Сторона квадрата и максимальная длительность кружка.
MAX_SIDE=640
MAX_DURATION=60

# Пресет x264: ultrafast / superfast / veryfast / faster / fast / medium / slow.
FFMPEG_PRESET=fast

# Сколько видео можно конвертировать одновременно.
MAX_CONCURRENT=2

# Таймауты, секунды.
DOWNLOAD_TIMEOUT=600
CONVERT_TIMEOUT=600

# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
